# Copy to .env and fill in. Never commit .env.

# Judge calls (judge.provider = "anthropic"). The SDK can also use an `ant auth login` profile.
ANTHROPIC_API_KEY=

# LangSmith tracking. Leave empty to run with tracking disabled (a warning is printed).
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=promptbench

# PromptBench overrides
# PROMPTBENCH_TRACKING=off
# PROMPTBENCH_JUDGE_SAMPLES=1
# PROMPTBENCH_LIVE=1          # enable tests marked `live`
